NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
GEMINI_API_KEY=
# Exact ID of a Gemini model supporting image input and JSON structured output.
GEMINI_MODEL=gemini-3.1-flash-lite

# Server-only address search key. Do not prefix with NEXT_PUBLIC_.
GEOAPIFY_API_KEY=
# Separate browser map-tiles key; restrict it to your website domains in Geoapify.
NEXT_PUBLIC_GEOAPIFY_MAPS_KEY=

# --- Pengepul flow ---
# Server-only Supabase secret key (bypasses RLS). Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Web push keys: pnpm dlx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:tim@example.com
VAPID_SUBJECT=
# SMTP for resident and admin emails (e.g. Gmail with an app password, port 465 or 587).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Kasitronik <no-reply@example.com>"
# Receives unclaimed-report and problem-report alerts.
ADMIN_EMAIL=
# Shared secret sent as x-cron-secret by the VPS crontab.
CRON_SECRET=
# Public site origin without trailing slash, used in notification links.
APP_BASE_URL=http://localhost:3000
