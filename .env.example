NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
GEMINI_API_KEY=
# Exact ID of a Gemini model supporting image input and JSON structured output.
GEMINI_MODEL=gemini-3.1-flash-lite

# Server-only address search key. Do not prefix with NEXT_PUBLIC_.
GEOAPIFY_API_KEY=
# Separate browser map-tiles key; restrict it to your website domains in Geoapify.
NEXT_PUBLIC_GEOAPIFY_MAPS_KEY=
